[Unit]
Description=Robot Scope Go2 control safety bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson_orin_nano
WorkingDirectory=/home/jetson_orin_nano/robot-scope
EnvironmentFile=/home/jetson_orin_nano/.config/robot-scope/control.env
ExecStart=/home/jetson_orin_nano/robot-scope/scripts/run_go2_control_bridge_supervisor.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=2
KillMode=control-group
Environment=HOME=/home/jetson_orin_nano
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_SCOPE_GO2_INTERFACE=eno1
Environment=ROBOT_SCOPE_GO2_INTERFACE_CIDR=192.168.123.99/24

[Install]
WantedBy=multi-user.target
