# Internal Go2 host example. Copy as a private mode-0600 environment file.
# Verify both interfaces/addresses with actual host output before use.
# Install with --mode go2-nav and --build-jobs 2; services are not auto-started.
ROBOT_SCOPE_PORT=8088
ROBOT_SCOPE_DASHBOARD_ADDRESS=192.168.50.30
ROBOT_SCOPE_PROFILE=go2
ROBOT_SCOPE_MAPPING_PROFILE=go2-onboard
ROBOT_SCOPE_ROBOT_IP=192.168.123.161
ROBOT_SCOPE_GO2_INTERFACE=eth0
ROBOT_SCOPE_GO2_INTERFACE_CIDR=192.168.123.18/24
ROBOT_SCOPE_CAMERA_INTERFACE=eth0
# Blank selects repository-owned config/go2-onboard.json and
# config/hesai_xt16_onboard.yaml. Absolute trusted host-specific files may override.
ROBOT_SCOPE_ROBOT_PROFILE_PATH=
ROBOT_SCOPE_HESAI_CONFIG_PATH=
# Build new pinned workspaces here, separate from manufacturer workspaces.
ROBOT_SCOPE_WORKSPACE_ROOT=/home/unitree/robot-scope-workspaces
ROBOT_SCOPE_LIVOX_SDK_PREFIX=
ROBOT_SCOPE_BUILD_JOBS=2
PYTHONNOUSERSITE=1
# Preserve durable data independently of release source/venv/build trees.
ROBOT_SCOPE_RUNTIME_DIR=/home/unitree/robot-scope-data/runtime
ROBOT_SCOPE_MAPS_DIR=/home/unitree/robot-scope-data/maps
ROBOT_SCOPE_DATASET_DIR=/home/unitree/robot-scope-data/datasets
ROBOT_SCOPE_SPATIAL_ROUTE_DIR=/home/unitree/robot-scope-data/spatial-routes
ROBOT_SCOPE_OPERATOR_EVENT_DIR=/home/unitree/robot-scope-data/operator-events
ROBOT_SCOPE_CONTROL_TRANSPORT=ros
ROBOT_SCOPE_CONTROL_BRIDGE_LIFECYCLE_TRANSPORT=local
# Control credentials belong only in sibling control.env, never this example.
ROBOT_SCOPE_CONTROL_ENABLED=0
ROBOT_SCOPE_SERVICE_LIFECYCLE_ENABLED=0
ROBOT_SCOPE_CONTROL_BRIDGE_LIFECYCLE_ENABLED=0
# Optional local RealSense: camera service has its own private env with
# ACCESS_MODE=local and identical private bind/dashboard address.
ROBOT_SCOPE_REALSENSE_RELAY_HOST=192.168.50.30
ROBOT_SCOPE_REALSENSE_PORT=8090
ROBOT_SCOPE_REALSENSE_PROFILE_CONTROL_ENABLED=0
ROBOT_SCOPE_REALSENSE_PROFILE_LIFECYCLE_MODE=local
# Optional inference remains disabled unless an actually used deployment opts in.
ROBOT_SCOPE_PERCEPTION_SOURCE_IP=
ROBOT_SCOPE_D2_STATIONARY_OBSERVER=0
ROBOT_SCOPE_D2_STATIONARY_RELOCALIZATION=0
