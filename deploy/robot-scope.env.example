# Robot Scope host configuration for Ubuntu 22.04/Humble or 24.04/Jazzy.
# Jetson Orin Nano is a tested host, not a requirement.
#
# The project-local service examples use runtime/config/robot-scope.env.
# The portable installer may render a host-specific path instead. Use mode 0600.
# Keep values literal: this file is read as dotenv/systemd EnvironmentFile data,
# not as a shell script. Never commit the populated copy.

# Core observer/dashboard settings.
ROBOT_SCOPE_PORT=8088
ROBOT_SCOPE_PROFILE=generic
ROBOT_SCOPE_ROBOT_IP=
ROBOT_SCOPE_OVERLAY=
# Blank means the service user's HOME. Custom paths must be absolute because
# systemd EnvironmentFile does not expand '~' or shell variables.
ROBOT_SCOPE_WORKSPACE_ROOT=
# Blank means <project>/runtime.  A custom value must be an absolute path.
ROBOT_SCOPE_RUNTIME_DIR=
# Blank means RUNTIME_DIR/datasets. This is server-side capture data and is
# ignored by Git. Custom paths must be absolute, non-root real directories.
ROBOT_SCOPE_DATASET_DIR=
# Optional real paths under RUNTIME_DIR/state. Symlinks are rejected.
ROBOT_SCOPE_STATE_DIR=
ROBOT_SCOPE_SOURCE_SELECTION_STATE=
ROBOT_SCOPE_NAVIGATION_RUNTIME_DIR=
# Blank means RUNTIME_DIR/logs/ros.
ROS_LOG_DIR=
# Blank follows WORKSPACE_ROOT/ws/livox/sdk2_install.
ROBOT_SCOPE_LIVOX_SDK_PREFIX=

# Go2 dedicated wired network. Change the interface name for this host.
ROBOT_SCOPE_GO2_INTERFACE=eno1
ROBOT_SCOPE_GO2_INTERFACE_CIDR=192.168.123.99/24
ROBOT_SCOPE_CAMERA_INTERFACE=eno1

# Optional robot-mounted RealSense relay address used by the dashboard's fixed
# HTTP MJPEG receiver. This is the relay/CWP host, not ROBOT_SCOPE_ROBOT_IP.
# It must be an explicit RFC1918 or link-local IPv4 address.
ROBOT_SCOPE_REALSENSE_RELAY_HOST=192.168.123.18
# Must equal the robot-side ROBOT_SCOPE_REALSENSE_PORT. Missing retains the
# reference 8090; a present blank or invalid value fails the receiver closed.
ROBOT_SCOPE_REALSENSE_PORT=8090

# Optional WP04 shadow-perception result receiver. Both the fixed robot-side
# private IP and a host-local, absolute allowlist policy are required. This is
# a read-only pull path on one fixed endpoint and has no control authority.
ROBOT_SCOPE_PERCEPTION_SOURCE_IP=
ROBOT_SCOPE_PERCEPTION_RESULT_PORT=8092
ROBOT_SCOPE_PERCEPTION_POLICY=

# WP05 local data/model provenance. Registry files, packages and TensorRT
# engines are runtime artifacts and must never be committed to Git.
ROBOT_SCOPE_MODEL_REGISTRY_DIR=
ROBOT_SCOPE_NETWORK_TOPOLOGY_REVISION=be5100m-management-v1
# Set this to the exact deployed repository commit (7-64 lowercase hex).
ROBOT_SCOPE_GIT_COMMIT=

# Optional map/runtime locations. Blank values retain the application defaults.
ROBOT_SCOPE_MAPS_DIR=
ROBOT_SCOPE_MAPPING_LOG_DIR=

# Go2 control is fail-closed. The installer creates a separate mode-0600
# control.env on the installation host for control modes. Never put its secret
# bridge key in this non-secret template.
ROBOT_SCOPE_CONTROL_ENABLED=0

# Optional fully wireless control transport. The default "ros" keeps the
# signed command/status topics on the same DDS host as the bridge. "udp" sends
# only those already signed envelopes to one fixed private peer on repository-
# owned UDP port 46010; it never relays arbitrary ROS/DDS traffic.
ROBOT_SCOPE_CONTROL_TRANSPORT=ros
ROBOT_SCOPE_CONTROL_DATAGRAM_BIND_HOST=
ROBOT_SCOPE_CONTROL_DATAGRAM_PEER_HOST=

# Optional robot-mounted relay target used only for no-auth reachability checks
# and explicit deployment workflows. Use SSH public keys; never put a password
# in this file, a command argument, or a log.
ROBOT_SCOPE_XT16_RELAY_HOST=192.168.123.18
ROBOT_SCOPE_XT16_RELAY_USER=unitree

# Service lifecycle control is a separate opt-in. It uses explicit UI
# confirmation and same-origin checks, so enable it only on a trusted LAN.
ROBOT_SCOPE_SERVICE_LIFECYCLE_ENABLED=0

# Independent opt-in for the Controls-page start/stop buttons for the fixed
# robot-scope-control-bridge.service unit. Requires the narrow sudoers example.
ROBOT_SCOPE_CONTROL_BRIDGE_LIFECYCLE_ENABLED=0
# "local" uses the host's fixed systemd unit. "ssh" uses one restricted key
# whose robot-side forced command accepts only status/start/stop for that unit.
ROBOT_SCOPE_CONTROL_BRIDGE_LIFECYCLE_TRANSPORT=local
ROBOT_SCOPE_CONTROL_BRIDGE_REMOTE_USER=
ROBOT_SCOPE_CONTROL_BRIDGE_SSH_IDENTITY=
ROBOT_SCOPE_CONTROL_BRIDGE_SSH_KNOWN_HOSTS=
