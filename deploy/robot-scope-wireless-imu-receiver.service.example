[Unit]
Description=Robot Scope authenticated minimum Go2 IMU receiver
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
ConditionFileIsExecutable=/home/jetson_orin_nano/project/robot-scope/scripts/run_wireless_imu_receiver_humble.sh
ConditionFileNotEmpty=/etc/robot-scope/wireless-imu.key
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson_orin_nano
Group=jetson_orin_nano
WorkingDirectory=/home/jetson_orin_nano/project/robot-scope
ExecStart=/home/jetson_orin_nano/project/robot-scope/scripts/run_wireless_imu_receiver_humble.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=3

CapabilityBoundingSet=
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
LimitNOFILE=32

[Install]
# Installer must leave this unit disabled. Gate 4 does not install or start it.
WantedBy=multi-user.target
