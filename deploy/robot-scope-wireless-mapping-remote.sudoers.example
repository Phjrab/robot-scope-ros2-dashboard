# Install only on the robot-side Jetson as
# /etc/sudoers.d/robot-scope-wireless-mapping-remote, owner root:root mode 0440.
# The forced SSH command can mutate only the two disabled-by-default sensor units.
unitree ALL=(root) NOPASSWD: \
    /usr/bin/systemctl --no-block start robot-scope-xt16-wireless-relay.service, \
    /usr/bin/systemctl --no-block stop robot-scope-xt16-wireless-relay.service, \
    /usr/bin/systemctl --no-block start robot-scope-wireless-imu-sender.service, \
    /usr/bin/systemctl --no-block stop robot-scope-wireless-imu-sender.service, \
    /usr/bin/journalctl --no-pager -o cat --since\=-15s -n 32 -u robot-scope-xt16-wireless-relay.service
