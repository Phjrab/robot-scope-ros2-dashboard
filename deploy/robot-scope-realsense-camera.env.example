# Robot-mounted RealSense relay network policy. Install a host-specific copy as
# /home/unitree/.config/robot-scope/realsense-camera.env with mode 0600.
# Values must be explicit RFC1918 or link-local IPv4 addresses. The relay never
# accepts a wildcard, public, loopback, hostname or URL value.

# Address owned by the robot-mounted Jetson interface carrying the relay link.
ROBOT_SCOPE_REALSENSE_BIND_HOST=192.168.123.18

# Only this dashboard host may read /stream. /health additionally permits the
# relay host itself and loopback.
ROBOT_SCOPE_REALSENSE_DASHBOARD_HOST=192.168.123.99

# Reference deployment profile. The relay accepts only TCP ports 1024-65535,
# the finite resolutions 320x240, 640x480 or 1280x720, FPS 5/10/15/30, and
# JPEG quality 40-90. Keep the 640x480@15/Q72 baseline until bandwidth and
# robot-side CPU/thermal measurements approve another profile.
ROBOT_SCOPE_REALSENSE_PORT=8090
ROBOT_SCOPE_REALSENSE_WIDTH=640
ROBOT_SCOPE_REALSENSE_HEIGHT=480
ROBOT_SCOPE_REALSENSE_FPS=15
ROBOT_SCOPE_REALSENSE_JPEG_QUALITY=72
