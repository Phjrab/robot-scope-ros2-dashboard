# Robot-side Jetson private environment. Install outside Git with mode 0600.
# Copy the existing dashboard Control Bridge key through an authenticated
# private channel. A blank key deliberately prevents service startup.
ROBOT_SCOPE_CONTROL_ENABLED=1
ROBOT_SCOPE_CONTROL_BRIDGE_KEY=
ROBOT_SCOPE_CONTROL_TRANSPORT=udp
ROBOT_SCOPE_CONTROL_DATAGRAM_BIND_HOST=192.168.50.30
ROBOT_SCOPE_CONTROL_DATAGRAM_PEER_HOST=192.168.50.10
ROBOT_SCOPE_GO2_INTERFACE=eth0
ROBOT_SCOPE_GO2_INTERFACE_CIDR=192.168.123.18/24
ROBOT_SCOPE_ROS_SETUP=/opt/ros/foxy/setup.bash
ROBOT_SCOPE_UNITREE_SETUP=/home/unitree/autonomy_stack_go2/install/setup.bash
ROBOT_SCOPE_CYCLONEDDS_SETUP=/home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash
