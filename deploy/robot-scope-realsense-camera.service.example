[Unit]
Description=Robot Scope on-demand RealSense color MJPEG relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=unitree
Group=unitree
SupplementaryGroups=video
WorkingDirectory=/
# A missing deployment contract is a startup error. Install the reviewed
# mode-0600 copy before starting this unit; no source edit is required.
EnvironmentFile=/home/unitree/.config/robot-scope/realsense-camera.env
Environment=GST_REGISTRY=/tmp/robot-scope-gstreamer-registry.bin
ExecStart=/usr/bin/python3 /usr/local/libexec/robot-scope/realsense_mjpeg_relay.py
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

# The relay needs the allowlisted /dev/v4l/by-id camera and no capabilities.
PrivateDevices=false
NoNewPrivileges=true
CapabilityBoundingSet=
# The optional fixed-argv `iw dev <iface> link` probe uses generic netlink.
# AF_NETLINK does not grant mutation authority; the unprivileged service still
# has no capabilities and cannot change interface or route configuration.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

UMask=0077
PrivateTmp=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
# ProtectClock is intentionally omitted on systemd 245: it injects a
# char-rtc DeviceAllow rule, which turns DevicePolicy=auto into a closed
# device policy and blocks the allowlisted RealSense/NVIDIA device nodes.
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
# NVIDIA's nvjpegenc stack performs runtime relocations that are incompatible
# with MemoryDenyWriteExecute on JetPack 5 / Ubuntu 20.04.  The service remains
# non-root, capability-free, syscall-filtered, and executes a root-owned file.
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
LimitNOFILE=64

[Install]
WantedBy=multi-user.target
