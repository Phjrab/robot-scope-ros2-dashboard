# Robot-side shadow-only perception contract. Install a host-specific copy as
# /home/unitree/.config/robot-scope/perception-shadow.env with mode 0600.
# This process consumes the existing relay; it never opens /dev/video*.

# Must be the exact locally assigned robot-side management address and the same
# port/profile used by robot-scope-realsense-camera.service.
ROBOT_SCOPE_PERCEPTION_SOURCE_HOST=192.168.50.30
ROBOT_SCOPE_PERCEPTION_SOURCE_PORT=8090
ROBOT_SCOPE_PERCEPTION_WIDTH=640
ROBOT_SCOPE_PERCEPTION_HEIGHT=480

# Read-only WP04 result endpoint. Bind only the robot-side management address
# and accept only the external Orin management address.
ROBOT_SCOPE_PERCEPTION_RESULT_HOST=192.168.50.30
ROBOT_SCOPE_PERCEPTION_RESULT_PEER=192.168.50.10
ROBOT_SCOPE_PERCEPTION_RESULT_PORT=8092

# Values are filenames, not paths. Files and artifacts live below the fixed
# root /var/lib/robot-scope/perception/models and are validated before start.
ROBOT_SCOPE_PERCEPTION_LANE_MANIFEST=lane-shadow.json
ROBOT_SCOPE_PERCEPTION_OBJECT_MANIFEST=object-shadow.json
ROBOT_SCOPE_PERCEPTION_DEPTH_MANIFEST=

# Independent bounded engine rates. Increasing these values requires new
# coexistence and thermal evidence; queue depth is never increased instead.
ROBOT_SCOPE_PERCEPTION_LANE_HZ=10
ROBOT_SCOPE_PERCEPTION_OBJECT_HZ=10
ROBOT_SCOPE_PERCEPTION_DEPTH_HZ=5

# OFF is the default. SUMMARY requires an approved depth_summary manifest.
# DECIMATED_DIAGNOSTIC and RAW_DIAGNOSTIC are intentionally rejected by WP03.
ROBOT_SCOPE_PERCEPTION_POINTCLOUD_MODE=OFF
