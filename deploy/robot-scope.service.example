[Unit]
Description=Robot Scope ROS 2 dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jetson_orin_nano
WorkingDirectory=/home/jetson_orin_nano/project/robot-scope
EnvironmentFile=-/home/jetson_orin_nano/project/robot-scope/runtime/config/robot-scope.env
EnvironmentFile=-/home/jetson_orin_nano/project/robot-scope/runtime/config/control.env
ExecStart=/home/jetson_orin_nano/project/robot-scope/scripts/run_go2_dashboard_supervisor.py
Restart=on-failure
RestartSec=3
KillMode=mixed
Environment=HOME=/home/jetson_orin_nano
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
