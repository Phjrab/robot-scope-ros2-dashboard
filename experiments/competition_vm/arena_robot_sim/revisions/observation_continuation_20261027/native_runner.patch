+def raw_body_contact(world, poses, scene_time):
+    """Sampled original-truth contact, separate from effective padded counters.
+
+    Only D0 shared worlds expose qualified raw geometry. Other worlds are unknown.
+    This is offline observation only: truth is never sent to Nav2 or commands.
+    """
+    if not all(hasattr(world, x) for x in ("raw_body", "boundary", "forbidden")):
+        return None
+    from core import polygon, intersects
+    from d0_adapter import contains
+    import numpy as np
+    for pose in poses:
+        body = polygon(pose, world.raw_body)
+        if not contains(world.boundary, np.array([p[0] for p in body]),
+                        np.array([p[1] for p in body])).all():
+            return True
+        edges = zip(world.boundary, world.boundary[1:] + world.boundary[:1])
+        if any(intersects(body, [x, y]) for x, y in edges):
+            return True
+        if any(intersects(body, p) for p in world.forbidden + world.obstacles(scene_time)):
+            return True
+    return False
