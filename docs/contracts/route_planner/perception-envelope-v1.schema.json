{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-scope.local/contracts/route-planner/perception-envelope-v1.schema.json",
  "title": "Route Planner Perception Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source", "frame_id", "observed_at_ns", "sequence",
    "state", "confidence", "traffic", "crosswalks", "people", "aruco",
    "underpass_blocked"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1, "maxLength": 64},
    "frame_id": {"enum": ["base_link"]},
    "observed_at_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "state": {"enum": ["READY", "UNKNOWN", "FAILED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "traffic": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/traffic"}
    },
    "crosswalks": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/crosswalk"}
    },
    "people": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/person"}
    },
    "aruco": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/aruco"}
    },
    "underpass_blocked": {"type": ["boolean", "null"]}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "traffic": {
      "type": "object", "additionalProperties": false,
      "required": ["crosswalk_id", "signal"],
      "properties": {
        "crosswalk_id": {"$ref": "#/$defs/token"},
        "signal": {"enum": ["RED", "GREEN", "UNKNOWN"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "consecutive_frames": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "crosswalk": {
      "type": "object", "additionalProperties": false,
      "required": ["crosswalk_id", "visible", "lateral_offset_m", "heading_error_rad", "left_boundary_distance_m", "right_boundary_distance_m"],
      "properties": {
        "crosswalk_id": {"$ref": "#/$defs/token"},
        "visible": {"type": "boolean"},
        "lateral_offset_m": {"type": "number", "minimum": -100, "maximum": 100},
        "heading_error_rad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
        "left_boundary_distance_m": {"type": "number", "minimum": 0, "maximum": 100},
        "right_boundary_distance_m": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["crosswalk_id", "occupancy"],
      "properties": {
        "crosswalk_id": {"$ref": "#/$defs/token"},
        "occupancy": {"enum": ["CLEAR", "OCCUPIED", "UNKNOWN"]},
        "nearest_distance_m": {"type": "number", "minimum": 0, "maximum": 1000},
        "collision_risk": {"type": "boolean"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "aruco": {
      "type": "object", "additionalProperties": false,
      "required": ["venue_id", "docking_ready"],
      "properties": {
        "venue_id": {"$ref": "#/$defs/token"},
        "zone_id": {"$ref": "#/$defs/token"},
        "docking_ready": {"type": "boolean"},
        "marker_ids": {"type": "array", "maxItems": 16, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
        "target_pose": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "z", "yaw"],
          "properties": {
            "x": {"type": "number", "minimum": -1000, "maximum": 1000},
            "y": {"type": "number", "minimum": -1000, "maximum": 1000},
            "z": {"type": "number", "minimum": -1000, "maximum": 1000},
            "yaw": {"type": "number", "minimum": -1000, "maximum": 1000}
          }
        },
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
